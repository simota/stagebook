{
  "name": "setlist-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/third-party-licenses.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "playwright test --grep-invert measure",
    "measure": "playwright test e2e/measure.spec.ts && node scripts/static-metrics.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-serif-jp": "^5.3.1",
    "@fontsource/biz-udpgothic": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
